# Read at runtime via $env/dynamic/public, so one built image serves every
# environment. Copy to .env for local development.

# CyberFS API the dashboard reads.
PUBLIC_CYBERFS_API_URL=http://localhost:8000

# CyberdyneAuth, for the login handshake and token refresh.
PUBLIC_CYBERDYNE_AUTH_URL=http://localhost:8001

# Which OAuth provider the sign-in button starts.
PUBLIC_OAUTH_PROVIDER=google

# The callback is always <this app's origin>/auth/callback. It must appear in
# CyberdyneAuth's OAUTH_CLIENT_REDIRECT_ALLOWLIST, and this origin must appear
# in its CORS_ALLOWED_ORIGINS, or login fails at initiate -- before the user
# consents to anything.
