# CyberFS configuration.
#   cp .env.example .env
# Every setting in cyberfs.infrastructure.settings.Settings appears here;
# tests/unit/test_settings.py fails if the two drift apart.

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
API_ROOT_PATH=
CORS_ALLOWED_ORIGINS=[]
METRICS_ENABLED=true

# --- datastores ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://cyberfs:cyberfs@localhost:5432/cyberfs
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=cyberfs
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=cyberfs-content
MINIO_SECURE=false
MINIO_REGION=

# --- identity (CyberdyneAuth) ----------------------------------------------
CYBERDYNE_AUTH_BASE_URL=https://auth.backend.coolify.cyberdynecorp.ai
CYBERFS_CLIENT_ID=cyberfs
CYBERFS_CLIENT_SECRET=CHANGE_ME
OIDC_DISCOVERY_TTL_SECONDS=3600
JWKS_STALE_MAX_SECONDS=86400
JWKS_REFRESH_COOLDOWN_SECONDS=60
TOKEN_CLOCK_SKEW_SECONDS=60
RATELIMIT_AUTH_FAILURES_PER_MIN=30
# Local/test only -- startup fails if enabled in staging or production.
AUTH_DEV_MODE=false

# --- encryption ------------------------------------------------------------
# Development placeholder. Production startup rejects this exact value.
# Generate a real one with:  openssl rand -base64 32
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=
# Set only while a MASTER_KEY rotation is in progress.
MASTER_KEY_PREVIOUS=
ENCRYPTION_DEFAULT_ON=false
ENCRYPTION_FRAME_BYTES=65536
ASYNC_REWRAP_THRESHOLD_NODES=100

# --- filesystem ------------------------------------------------------------
DEFAULT_QUOTA_BYTES=10737418240
MAX_UPLOAD_BYTES=5368709120
UPLOAD_CHUNK_BYTES=8388608
MAX_TREE_DEPTH=64
PAGE_SIZE_DEFAULT=100
PAGE_SIZE_MAX=1000
VERSION_RETENTION_COUNT=10
TRASH_RETENTION_DAYS=30
ORPHAN_GRACE_MINUTES=60

# --- activity --------------------------------------------------------------
# How long operation records are kept before the prune job deletes them.
# Security records (denials, grants, transfers, encryption changes, admin
# actions) are retained separately and never pruned here.
ACTIVITY_RETENTION_DAYS=90
# Longest window GET /api/v1/me/activity will answer; a longer request is 422.
ACTIVITY_MAX_WINDOW_DAYS=90

# --- s3 compatibility ------------------------------------------------------
# Region a SigV4 credential scope must name; CyberFS reproduces the client's
# canonical request with it to verify the signature.
S3_REGION=us-east-1
# Maximum allowed drift between a signed x-amz-date and the server clock before
# a request is refused with RequestTimeTooSkewed.
S3_CLOCK_SKEW_SECONDS=300
# Mount the S3-compatible HTTP surface. Off by default: a deployment that does
# not offer S3 exposes no such routes.
S3_API_ENABLED=false
# Path the S3 surface is rooted at; standard clients point their endpoint here.
S3_BASE_PATH=/s3
# How long a multipart upload may sit neither completed nor aborted before the
# orphan reaper reclaims its staged parts.
S3_MULTIPART_ABANDON_HOURS=24
# Externally visible CyberFS S3 base URL (scheme + host). Presigned URLs and the
# multipart <Location> are rooted here so they address CyberFS's own endpoint,
# never the underlying object store. Leave blank to derive from the request host.
S3_PUBLIC_ENDPOINT=

# --- cache -----------------------------------------------------------------
CACHE_TTL_PERMISSION_SECONDS=60
CACHE_TTL_METADATA_SECONDS=300
CACHE_TTL_LISTING_SECONDS=120
CACHE_TTL_JWKS_SECONDS=3600
CACHE_TTL_QUOTA_SECONDS=300
CACHE_TTL_ADMIN_STATS_SECONDS=600
CACHE_OP_TIMEOUT_MS=50
CACHE_CIRCUIT_TRIP_SECONDS=10
# Bump to invalidate every cached entry on deploy.
CACHE_SCHEMA_VERSION=1

# --- admin -----------------------------------------------------------------
# Enabling this reveals other users' file names to admins; it is audited.
ADMIN_SHOW_FILENAMES=false

# --- sharing ---------------------------------------------------------------
PUBLIC_LINK_MAX_ATTEMPTS_PER_MIN=10
# How often the worker completes deferred rewraps of large shared subtrees
# (those over ASYNC_REWRAP_THRESHOLD_NODES). A share over the threshold is
# created pending and confers no access until this worker rewraps every
# encrypted descendant for the recipient.
REWRAP_CRON=*/2 * * * *

# --- backup ----------------------------------------------------------------
BACKUP_ENABLED=false
BACKUP_CRON=0 3 * * *
# Must differ from MINIO_ENDPOINT/MINIO_BUCKET -- startup rejects a target
# that points back at the primary.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_BUCKET=
BACKUP_VERIFY_SAMPLE_COUNT=50
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_FAILED_GRACE_HOURS=24
BACKUP_MAX_AGE_HOURS=48
BACKUP_HISTORY_DAYS=90
